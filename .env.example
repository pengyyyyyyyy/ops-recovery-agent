# Shared repository configuration. Copy to .env locally; never commit .env.
# offline uses a deterministic scripted model to test engineering behavior.
# It is NOT an LLM-quality evaluation. Change to online only after configuring a key.
OPS_MODEL_MODE=offline
OPS_API_BASE_URL=https://api.deepseek.com
OPS_MODEL_ID=deepseek-flash
OPS_API_KEY=
# Conservative peak rates, CNY / million tokens; verify your own provider's prices.
# DeepSeek snapshot 2026-11-18: https://api-docs.deepseek.com/zh-cn/quick_start/pricing/
OPS_INPUT_PRICE=2
OPS_OUTPUT_PRICE=8
OPS_BUDGET_CNY=100
OPS_MAX_OUTPUT_TOKENS=2048
OPS_MODEL_TIMEOUT=45
OPS_AGENT_DEADLINE=120
OPS_API_STYLE=deepseek
OPS_STATE_DIR=.state
